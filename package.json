{
  "name": "metalic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "parse": "node src/cli.ts",
    "bench": "node scripts/bench.ts",
    "bench:diagnostics": "node scripts/bench-diagnostics.ts",
    "bench:buffers": "node scripts/bench-buffers.ts",
    "bench:scheduling": "node scripts/bench-scheduling.ts",
    "bench:cooperation": "node scripts/bench-cooperation.ts",
    "bench:workloads": "node scripts/bench-workloads.ts",
    "bench:adaptive": "node scripts/bench-adaptive.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "description": "GPU-first language frontend and Nanopass experiments for Apple Metal",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizchi/metalic.git"
  }
}
